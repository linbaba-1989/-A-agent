# 生产模型：openai / deepseek / qwen / kimi / doubao
DEFAULT_MODEL=deepseek

OPENAI_API_KEY=
OPENAI_ENABLED=false
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.cn/v1
DOUBAO_API_KEY=
DOUBAO_MODEL=YOUR_DOUBAO_ENDPOINT_ID
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 可选成本参数：按各平台当前账单币种填写每百万 Token 单价。
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=
DEEPSEEK_INPUT_COST_PER_MILLION=
DEEPSEEK_OUTPUT_COST_PER_MILLION=
QWEN_INPUT_COST_PER_MILLION=
QWEN_OUTPUT_COST_PER_MILLION=
KIMI_INPUT_COST_PER_MILLION=
KIMI_OUTPUT_COST_PER_MILLION=
DOUBAO_INPUT_COST_PER_MILLION=
DOUBAO_OUTPUT_COST_PER_MILLION=

# P1.5 Model Arena 候选模型。默认关闭，不参与生产路由。
GLM_ENABLED=false
GLM_API_KEY=
GLM_MODEL=
GLM_BASE_URL=
HUNYUAN_ENABLED=false
HUNYUAN_API_KEY=
HUNYUAN_MODEL=
