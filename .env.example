# 选择模型：openai / deepseek / qwen / kimi / doubao
DEFAULT_MODEL=deepseek

OPENAI_API_KEY=
OPENAI_ENABLED=false
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.cn/v1
DOUBAO_API_KEY=
DOUBAO_MODEL=YOUR_DOUBAO_ENDPOINT_ID
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 可选成本参数：按各平台当前账单币种填写每百万 Token 单价。
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
DEEPSEEK_INPUT_COST_PER_MILLION=0
DEEPSEEK_OUTPUT_COST_PER_MILLION=0
QWEN_INPUT_COST_PER_MILLION=0
QWEN_OUTPUT_COST_PER_MILLION=0
KIMI_INPUT_COST_PER_MILLION=0
KIMI_OUTPUT_COST_PER_MILLION=0
DOUBAO_INPUT_COST_PER_MILLION=0
DOUBAO_OUTPUT_COST_PER_MILLION=0

# QMT：需要本机 QMT 已运行。xtquant 固定使用项目隔离的 official_230825b。
# QMT_PATH 仅用于显示和比较券商随附旧组件，不参与生产导入。
QMT_PATH=
QMT_PORT=58610
